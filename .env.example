# ============================================================
# OpenSourceCopilot · Environment Variables Template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- LLM Provider ---
# Pick one. Defaults to DeepSeek (cheap + Chinese-friendly).
LLM_PROVIDER=deepseek          # one of: deepseek | openai | zhipu
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com

# --- Embedding ---
EMBEDDING_TEXT_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_CODE_MODEL=microsoft/unixcoder-base

# --- GitHub API ---
# Create a fine-grained PAT with `public_repo` read access.
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_API_BASE=https://api.github.com

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Milvus (vector DB) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530

# --- Application ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# --- Seed repos (comma-separated owner/repo) ---
SEED_REPOS=langchain-ai/langchain,tiangolo/fastapi,vuejs/core,microsoft/vscode,encode/httpx
